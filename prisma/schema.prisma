// ₹50 TEAM incentive — one TOTAL amount recorded against one Job + the team
// that was assigned to it. Never split into individual shares and never
// written to any individual's payroll (owner rule, 2026-10-04 scope lock).
// Not tied to a Google review or star rating.
model TeamIncentive {
  id             String   @id @default(cuid())
  jobId          String   @unique // one team incentive per job
  amount         Float    @default(50)
  teamSnapshot   String // JSON [{staffId, name, isLead}] — the team as on the job
  notes          String?
  date           DateTime @default(now())
  recordedByName String?
