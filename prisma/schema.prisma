// CRM-native invoice document — Sahara OS's own billing record, generated
// automatically at job completion or created directly (e.g. from an
// accepted Quotation). No third-party billing API involved.
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  jobId           String?       @unique
  job             Job?          @relation(fields: [jobId], references: [id])
  paymentId       String?       @unique
  payment         Payment?      @relation(fields: [paymentId], references: [id])
  quotationId     String?       @unique
  quotation       Quotation?    @relation(fields: [quotationId], references: [id])
  customerName    String
  customerMobile  String?
  customerAddress String?
  lineItems       String // JSON [{name, description, amount}]
  subTotal        Float
  discount        Float         @default(0)
  gstPercent      Float         @default(0)
  gstAmount       Float         @default(0)
  totalAmount     Float
  notes           String?
  terms           String?
  pdfUrl          String?
  status          InvoiceStatus @default(ISSUED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model JobVideo {
