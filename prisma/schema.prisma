  url        String
  caption    String?
  uploadedAt DateTime @default(now())

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────
// Connector settings — a single row ("default"), edited from
// /settings → Integrations ("Connect Later"). Every third-party integration
// reads its credentials from here FIRST, then falls back to the matching
// environment variable, so a key can be pasted once in the UI without a
// redeploy. Secret fields (whatsappAccessToken, backupToken) are stored
// encrypted at rest with AES-256-GCM keyed off AUTH_SECRET — see
// src/lib/crypto.ts and src/server/integrations.ts.
// ─────────────────────────────────────────────────────────────────────────

model IntegrationSettings {
  id String @id @default("default")

  // WhatsApp Cloud API (Meta). accessToken is encrypted at rest.
  whatsappAccessToken   String?
  whatsappPhoneNumberId String?
  whatsappBusinessId    String?
  whatsappApiVersion    String   @default("v21.0")
  whatsappVerifiedAt    DateTime?
  whatsappLastError     String?

  // Google Maps JavaScript / Embed / Geocoding API. This key is delivered to
  // the browser by design — restrict it by HTTP referrer in Google Cloud.
  googleMapsApiKey     String?
  googleMapsVerifiedAt DateTime?

  // Web Push (VAPID). Public key is safe to ship to the browser; private key
  // encrypted at rest. Generated once from /settings if not provided by env.
  webPushPublicKey  String?
  webPushPrivateKey String?
  webPushSubject    String?

  // Google Drive nightly off-site backup. backupToken is encrypted at rest
  // and authorises GET /api/backup for the GitHub Actions workflow; the
  // Drive OAuth credentials themselves live in GitHub repo secrets because
  // the upload runs inside GitHub Actions, not this server.
  backupToken      String?
  gdriveFolderId   String?
  backupVerifiedAt DateTime?

  // SMS gateway (fallback channel for staff notifications + review requests).
  // apiKey encrypted at rest. provider is a free-text label (MSG91 / Twilio /
  // Fast2SMS / …); the send call is a generic HTTPS POST — see src/lib/sms.ts.
  smsProvider    String?
  smsApiKey      String?
  smsSenderId    String?
  smsEndpoint    String?
  smsVerifiedAt  DateTime?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Every SMS the app sends (staff attendance, review requests, reminders).
// Queued when no gateway is configured; flushed automatically once creds land.
model SmsMessage {
  id          String    @id @default(cuid())
  toNumber    String
  toName      String?
  body        String
  kind        String    @default("OTHER")
  status      String    @default("QUEUED") // QUEUED | SENT | FAILED
  attempts    Int       @default(0)
  error       String?
  relatedType String?
  relatedId   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

// Every email the app sends (currently: owner password/login-ID recovery
// notifications — see src/lib/email.ts). Queued when no provider is
// configured (EMAIL_* env vars); flushed automatically once they're set.
// Mirrors SmsMessage/WhatsAppMessage's queue-first pattern exactly.
model EmailMessage {
  id          String    @id @default(cuid())
  toEmail     String
  toName      String?
  subject     String
  body        String
  kind        String    @default("OTHER")
  status      String    @default("QUEUED") // QUEUED | SENT | FAILED
  attempts    Int       @default(0)
  error       String?
  relatedType String?
  relatedId   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Security — OTP for password reset/change, always delivered to the Super
// Admin (Altaf). Codes are hashed at rest.
// ─────────────────────────────────────────────────────────────────────────

model SecurityOtp {
  id              String    @id @default(cuid())
  purpose         String // PASSWORD_RESET | PASSWORD_CHANGE
  targetUserId    String // whose password is being changed
  targetUserName  String
  targetUserEmail String
  codeHash        String
  codePlain       String? // readable ONLY on the Super Admin's /admin/security-approvals page (in-app relay when WhatsApp is offline)
  payload         String? // e.g. the pending bcrypt hash to apply once the OTP is confirmed
  expiresAt       DateTime
  consumedAt      DateTime?
  attempts        Int       @default(0)
  requestedByName String?
  createdAt       DateTime  @default(now())

  @@index([targetUserId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Real-time notifications — role-routed in-app feed + Web Push fan-out.
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // NEW_BOOKING | NEW_INQUIRY | PAYMENT_RECEIVED | FOLLOWUP_DUE | STALE_LEAD | SITE_VISIT | CREW_UPDATE | DEVICE_LOGIN | PASSWORD_OTP | APPROVAL_REQUEST | LOGIN_ATTEMPT | LOGIN_ID_RECOVERY | Staff App: STAFF_ATTENDANCE | STAFF_ADVANCE | STAFF_FINE | STAFF_REWARD | STAFF_JOB_ASSIGNED | STAFF_JOB_CHANGED | ANNOUNCEMENT | STAFF_PIN_RESET
  title     String
  body      String?
  href      String?
  critical  Boolean   @default(false)
  meta      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastOkAt   DateTime @default(now())

  @@index([userId])
}
// ─────────────────────────────────────────────────────────────────────────
// Owner Command Center — ADMIN-editable monthly business revenue target.
// ─────────────────────────────────────────────────────────────────────────

model BusinessTarget {
  id           String   @id @default(cuid())
  year         Int
  month        Int // 1-12
  targetAmount Float
  setByName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, month])
}

// Monthly ad / marketing spend entered by the owner, per channel + campaign —
// feeds the admin Marketing ROI dashboard (spend → leads → bookings → revenue).
model MarketingSpend {
  id        String   @id @default(cuid())
  month     String // YYYY-MM
  channel   String // same values as Lead.acquisitionChannel
  campaign  String   @default("")
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  @@index([month])
  @@index([channel])
}

// ─────────────────────────────────────────────────────────────────────────
// Pricing & Packages (Super Admin). PRICING_MASTER in src/lib/pricing-master.ts
// holds the catalogue (names, scope, units); these tables hold the editable
// numbers. PriceSetting overrides an item's regular price; FestivalOffer +
// FestivalPrice hold separate festival prices for a date window. Bookings
// copy the price they were confirmed at, so edits never touch history.
// ─────────────────────────────────────────────────────────────────────────
// Manual slot-availability control (CRM → Jobs → Slot Availability). One row per
// date + slot; slot "*" is the whole day. status OPEN | FILLING | FULL overrides
// the automatic team-capacity calculation; teamCapacity (day row only) replaces
// the default crew count for that date. No row = automatic.
model BookingSlotControl {
  id            String   @id @default(cuid())
  date          String // YYYY-MM-DD (IST)
  slot          String // a TIME_SLOTS label, or "*" for the whole day
  status        String? // OPEN | FILLING | FULL
  teamCapacity  Int?
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@unique([date, slot])
}

model PriceSetting {
  contentId     String   @id
  price         Float?
  mrp           Float?
  isActive      Boolean  @default(true)
  updatedByName String?
  updatedAt     DateTime @updatedAt
}

model FestivalOffer {
  id            String          @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean         @default(true)
  updatedByName String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  prices        FestivalPrice[]

  @@index([isActive, startDate])
}

model FestivalPrice {
  id         String        @id @default(cuid())
  festivalId String
  festival   FestivalOffer @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  contentId  String
  price      Float

  @@unique([festivalId, contentId])
}

// ─────────────────────────────────────────────────────────────────────────
// Staff money ledgers (2026-10-05, Khata Book migration). Financial rows are
// NEVER hard-deleted — deletedAt/deletedByName only. Every imported row keeps
// its Khata Book source (party, row no., exact description) and a unique
// sourceHash so the same transaction can never be imported twice.
// ─────────────────────────────────────────────────────────────────────────

/** Salary ledger. kind: EARNING | OTHER_CREDIT | PAYMENT | ADVANCE | FINE | DEDUCTION | OPENING_BALANCE.
 *  amount is always positive; sign comes from kind (OPENING_BALANCE uses signedAmount). */
model StaffLedgerEntry {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])
  date          DateTime
  kind          String
  amount        Float
  signedAmount  Float // + = Sahara owes the worker, − = paid / deducted
  description   String?
  paymentMode   String? // CASH | UPI | GOOGLE_PAY | BANK_TRANSFER | OTHER
  reference     String? // UTR / transaction id / bank reference
  upiId         String?
  reversalOfId  String? // correction = a reversal entry, never an edit
  reason        String? // required for adjustments / reversals
  source        String    @default("MANUAL") // KHATABOOK | MANUAL
  sourceParty   String? // exact Khata Book party name
  sourceRow     Int? // Khata Book report S.No.
  sourceHash    String?   @unique
  batchId       String?
  createdByName String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedByName String?

  @@index([staffId, date])
  @@index([batchId])
}

/** Loan ledger — separate from salary. kind: LOAN_GIVEN | LOAN_REPAID | LOAN_OPENING.
 *  fromSalary = recovery cut from salary (also reduces Salary Due). */
/** Overtime — separate from multiple jobs. Only Super Admin / Accounts approve; only APPROVED counts as earning. */
model OvertimeRecord {
  id             String    @id @default(cuid())
  staffId        String
  staff          Staff     @relation(fields: [staffId], references: [id])
  date           DateTime
  jobId          String?
  regularHours   Float     @default(8)
  otHours        Float
  otRate         Float // per hour
  otAmount       Float
  reason         String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdByName  String?
  approvedByName String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  deletedByName  String?

  @@index([staffId, date])
  @@index([status])
}

model StaffLoanEntry {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])
  date          DateTime
  kind          String
  amount        Float
  signedAmount  Float // + = loan outstanding increases, − = repaid
  fromSalary    Boolean   @default(false)
  description   String?
  reversalOfId  String? // correction = an opposite row pointing at the original, never an edit
  reason        String? // required for corrections
  source        String    @default("MANUAL")
  sourceParty   String?
  sourceRow     Int?
  sourceHash    String?   @unique
  batchId       String?
  createdByName String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedByName String?

  @@index([staffId, date])
  @@index([batchId])
}

/** Read receipt per staff user for office announcements. */
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
}

model KhataImportBatch {
  id            String    @id @default(cuid())
  status        String // PREVIEW | APPLIED | PARTIAL | FAILED | ROLLED_BACK
  cutoffDate    DateTime
  sourceName    String?
  sourceRows    Int?
  datasetJson   String // uploaded dataset (kept for audit)
  previewJson   String?
  resultJson    String?
  snapshotFile  String?
  createdByName String?
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?
  rolledBackAt  DateTime?
}

model KhataImportLog {
  id           String   @id @default(cuid())
  batchId      String
  party        String
  staffId      String?
  staffName    String?
  sourceRow    Int?
  date         DateTime?
  amount       Float?
  type         String?
  description  String?
  destination  String? // e.g. StaffLedgerEntry:<id>
  status       String // MIGRATED | SKIPPED_DUPLICATE | BLOCKED | FAILED | ROLLED_BACK
  message      String?
  createdAt    DateTime @default(now())

  @@index([batchId])
  @@index([party])
}
