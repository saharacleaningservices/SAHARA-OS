}

// Company announcements published from the CRM and shown in the Staff App.
model Announcement {
  id            String    @id @default(cuid())
  title         String
  body          String
  important     Boolean   @default(false)
  isActive      Boolean   @default(true)
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?
  createdByName String?
  createdAt     DateTime  @default(now())
  // Recipients: ALL | STAFF (staffIds) | TEAM (teamNumbers). Office messages only — never auto job alerts.
  audience      String    @default("ALL")
  staffIds      String? // JSON array of Staff ids
