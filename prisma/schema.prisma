// Sahara OS — Prisma schema
// SQLite for Phase 1. Field types are chosen to be PostgreSQL-compatible
// so migrating `provider = "postgresql"` later needs no schema changes
// beyond enum/array support.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATIONS
  ACCOUNTS
  SUPERVISOR
  STAFF
}

enum LeadSource {
  WHATSAPP
  CALL
  WEBSITE
  GOOGLE
  GMB
  FACEBOOK
  INSTAGRAM
  META
}

enum ServiceType {
  HOME_DEEP_CLEANING
  COMMERCIAL_CLEANING
  HOUSEKEEPING
  PEST_CONTROL
  INTERIOR_PAINTING
}

enum LeadStage {
  NEW
  INTERESTED
  SITE_VISIT
  QUOTATION
  NEGOTIATION
  CONFIRMED
  JOB_SCHEDULED
  CANCELLED
  COMPLETED
}

enum JobStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  STARTED
  COMPLETED
  POSTPONED
  CANCELLED
  REACTIVATED
}

enum PaymentStatus {
  PENDING
  DUE_SOON
  OVERDUE
  PAID
}

enum ExpenseCategory {
  HOUSEKEEPING_MATERIAL
  FUEL
  AUTO_CAB_FARE
  EQUIPMENT
  BIKE_SERVICE
  STAFF_ADVANCE
  VENDOR_PAYMENT
  MISCELLANEOUS
  SALARY // salary paid out — link the staff member (Expense.staffId)
  OFFICE_RENT
  MACHINE_REPAIR
  // legacy — kept so historical rows still deserialize
  CHEMICALS
  BACK_OFFICE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
}

enum PhotoType {
  BEFORE
  AFTER
}

enum StaffAvailability {
  AVAILABLE
  ON_JOB
  ON_LEAVE
  OFF_DUTY
}

enum SalaryType {
  DAILY
  MONTHLY
}

enum FollowUpType {
  CALL
  WHATSAPP
  SITE_VISIT
  PAYMENT
  CUSTOM
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  CALL
}

// Conversation timeline entry kinds (WhatsApp-style enquiry history).
enum TimelineType {
  NOTE
  VOICE
  CALL
  STAGE
  QUOTATION
  JOB
  PAYMENT
  FOLLOW_UP
  SYSTEM
}

// Phase 2 — Production Foundation
enum ServiceCategory {
  HOME_DEEP_CLEANING
  INDIVIDUAL_CLEANING
  PAINTING
  PEST_CONTROL
  HOUSEKEEPING
  COMMERCIAL_CLEANING
  AMC
  CUSTOMIZER_PACKAGE
  COMBO_PACKAGE
}

// Phase 3 — Revenue, WhatsApp & Workforce Automation
enum AmcCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum AmcFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum AmcStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WhatsAppKind {
  BOOKING_CONFIRMATION
  TEAM_DISPATCH
  CUSTOMER_REMINDER
  PAYMENT_REMINDER
  REVIEW_REQUEST
  REVIEW_CAMPAIGN
  AMC_RENEWAL
  ATTENDANCE_SUMMARY
  DEVICE_APPROVAL
  DAILY_SUMMARY
  MONTHLY_SUMMARY
  OTHER
}

enum WhatsAppStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED // withdrawn by an admin; never flushed or retried (flush only picks QUEUED/FAILED)
  RECEIVED // inbound customer message (never flushed)
}

enum DeviceStatus {
  PENDING
  APPROVED
  DENIED
}

// ─────────────────────────────────────────────────────────────────────────
// Core auth / people
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  phone               String?
  passwordHash        String
  role                Role
  avatarUrl           String?
  isActive            Boolean  @default(true)
  mustChangePassword  Boolean  @default(false) // force a policy-compliant reset on next login
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  staffProfile        Staff?
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  leadsCreated          Lead[]        @relation("LeadCreatedBy")
  leadsAssigned         Lead[]        @relation("LeadAssignedTo")
  followUpsAssigned     FollowUp[]    @relation("FollowUpAssignedTo")
  expensesAdded         Expense[]     @relation("ExpenseAddedBy")
  photosUploaded        Photo[]       @relation("PhotoUploadedBy")
  activityLogs          ActivityLog[] @relation("ActivityActor")
  paymentsRecorded      Payment[]     @relation("PaymentRecordedBy")
  timelineEntries        TimelineEntry[] @relation("TimelineAuthor")
  devices               Device[]

  @@index([role])
}

// Owner-controlled device login. Any new (unrecognized) browser/device
// signing in as OPERATIONS or SUPERVISOR needs Altaf's explicit approval
// before a session is issued — see src/server/actions/device-approval.ts
// and src/app/(app)/admin/device-approvals.
model Device {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String       @unique
  label          String?
  ipAddress      String?
  status         DeviceStatus @default(PENDING)
  otpCode        String?
  otpExpiresAt   DateTime?
  approvedAt     DateTime?
  approvedByName String?
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([status])
}

model Staff {
  id              String            @id @default(cuid())
  employeeCode    String            @unique
  name            String
  mobile          String
  designation     String // e.g. Cleaning Executive, Supervisor, Painter, Pest Control Technician
  alternateMobile String?
  salaryType      SalaryType        @default(DAILY)
  dailyWage       Float?
  monthlySalary   Float?
  availability    StaffAvailability @default(AVAILABLE)
  joinDate        DateTime          @default(now())
  joiningDate     DateTime? // HR joining date (editable; joinDate is the system default)
  reference       String? // who referred / hired this staff member
  bankAccount     String?
  bankIfsc        String?
  gpayNumber      String?
  documents       String? // JSON array [{label,url,uploadedAt}] — Aadhaar/PAN/passbook/etc.
  isActive        Boolean           @default(true)
  photoUrl        String?
  notes           String?
  // Khata Book migration (2026-10-05): history up to this moment lives in
  // StaffLedgerEntry; attendance/advances/fines/salary-paid dated after it
  // are added on top. Null = no imported history (native data only).
  ledgerCutoverAt DateTime?
  language        String? // Staff App language: en | hi | mr
  bankName        String?
  bankAccountName String?
  upiId           String?
  qrCode          String?           @unique // future QR check-in token
  userId          String?           @unique
  user            User?             @relation(fields: [userId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  attendance      Attendance[]
  jobAssignments  JobAssignment[]
  supervisedJobs  Job[]           @relation("JobSupervisor")
  leadAssignments Lead[]          @relation("LeadAssignedStaff")
  expenses        Expense[]       @relation("ExpenseStaff")
  advances        Advance[]
  fines           FineRecord[]
  rewards         RewardRecord[]
  ledgerEntries   StaffLedgerEntry[]
  overtime        OvertimeRecord[]
  loanEntries     StaffLoanEntry[]

  @@index([availability])
  @@index([designation])
}

model Attendance {
  id            String           @id @default(cuid())
  staffId       String
  staff         Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date          DateTime
  status        AttendanceStatus @default(PRESENT)
  checkInTime   DateTime?
  checkOutTime  DateTime?
  wageForDay    Float?
  gpsLat        Float? // future GPS attendance
  gpsLng        Float? // future GPS attendance
  method        String           @default("MANUAL") // MANUAL | QR | GPS (future-ready)
  notes         String?
  markedByName  String? // office user who first set this day
  updatedByName String? // office user who last edited it
  updatedAt     DateTime?
  createdAt     DateTime         @default(now())

  @@unique([staffId, date])
  @@index([date])
  @@index([status])
}

// Immutable edit trail for attendance — every create/change writes a row here.
// Never deleted (Phase 4: "No permanent deletion").
model AttendanceAudit {
  id           String   @id @default(cuid())
  staffId      String
  staffName    String
  date         DateTime
  oldStatus    String? // null = first time the day was marked
  newStatus    String
  editedByName String
  editedAt     DateTime @default(now())

  @@index([staffId, date])
  @@index([editedAt])
}

// Marketing gallery — before/after photos and result videos, uploaded by the
// office and reused on the booking page, in WhatsApp links and review campaigns.
model GalleryItem {
  id            String   @id @default(cuid())
  type          String   @default("PHOTO") // PHOTO | VIDEO
  kind          String   @default("GENERAL") // BEFORE | AFTER | GENERAL
  category      String? // Home Cleaning | Commercial | Painting | Pest Control
  url           String
  thumbnailUrl  String?
  caption       String?
  jobId         String?
  pairKey       String? // links a BEFORE + AFTER of the same job
  featured      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdByName String
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([featured])
  @@index([category])
}

// Imported / master customer record. The CRM still derives "customers" from
// Leads + Jobs by mobile; this table is an additive master layer for the
// existing 6000-customer base (bulk import, merge-by-mobile). Never blocks
// or replaces lead/job history.
model Customer {
  id                 String    @id @default(cuid())
  name               String
  mobile             String    @unique
  alternateMobile    String?
  address            String?
  area               String?
  serviceHistory     String?
  lastServiceDate    DateTime?
  outstandingBalance Float     @default(0)
  source             String?
  notes              String?
  importBatchId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([area])
  @@index([lastServiceDate])
}

// A personalized customer link (booking form / follow-up / review request)
// sent over WhatsApp from the CRM. Tracks the funnel: sent → opened → submitted.
model BookingLink {
  id             String    @id @default(cuid())
  token          String    @unique
  kind           String    @default("BOOKING_FORM") // BOOKING_FORM | FOLLOWUP | REVIEW
  customerName   String
  customerMobile String
  leadId         String?
  jobId          String?
  createdByName  String
  sentAt         DateTime  @default(now())
  openedAt       DateTime?
  submittedAt    DateTime?
  followUpMade   Boolean   @default(false)

  @@index([customerMobile])
  @@index([sentAt])
}

// One row per closed payroll month. Present + reopenedAt == null → locked.
model MonthClose {
  id             String    @id @default(cuid())
  year           Int
  month          Int // 1-12
  closedByName   String
  closedAt       DateTime  @default(now())
  reopenedByName String?
  reopenedAt     DateTime?

  @@unique([year, month])
}

// ─────────────────────────────────────────────────────────────────────────
// Leads / CRM pipeline
// ─────────────────────────────────────────────────────────────────────────

model Lead {
  id              String      @id @default(cuid())
  leadNumber      String      @unique
  name            String
  mobile          String
  alternateMobile String? // optional second contact number
  whatsapp        String?
  email           String?
  address         String?
  area            String
  pinCode         String? // 6-digit PIN — replaces the free-text Area field on forms
  addOnServices   String? // JSON array of add-on service names picked on the booking form
  service         ServiceType
  source          LeadSource
  quoteAmount     Float?
  stage           LeadStage   @default(NEW)
  intakeKey       String?   @unique // automatic-intake idempotency key, e.g. "WA:<mobile>:<IST day>" — one WhatsApp lead per customer per day
  followUpDate    DateTime?
  serviceDate     DateTime? // customer-requested service date (from the booking form) — distinct from followUpDate
  timeSlot        String? // customer-requested slot, e.g. "10:00 AM" — carried into Job.scheduledTime on confirm
  teamNumber      Int? // internal crew team 1–4, carried into the Job on confirm
  notes           String?

  serviceCategory  ServiceCategory?
  serviceVariant   String?
  propertyType     String? // 1-5 BHK / Villa / Office / Shop … (v2.0 booking form)
  packageName      String? // optional package tier (Premium/Platinum/…)
  comboServices    String? // JSON array of combo bundles picked
  assignedStaffIds String? // JSON array of Staff ids — multi-staff assignment; assignedStaffId stays as the primary

  // Advance payment captured at booking / manual lead entry. quoteAmount is
  // the estimated total; balance is quoteAmount - advanceAmount.
  advanceAmount Float?
  paymentMode   String? // UPI | QR | BANK | CASH
  paymentStatus String? // PENDING | PARTIAL | PAID | PENDING_ADVANCE
  mapLink       String?
  referralCode  String?

  // Marketing attribution (2026-09-29 independent marketing system).
  // acquisitionChannel is the ORIGINAL source and is never overwritten once
  // set — later touches only update the latestTouch* fields.
  acquisitionChannel  String?
  acquisitionCampaign String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmTerm             String?
  utmContent          String?
  gclid               String?
  fbclid              String?
  landingPage         String?
  landingPageUrl      String?
  firstTouchSource    String?
  firstTouchMedium    String?
  firstTouchCampaign  String?
  firstTouchAt        DateTime?
  latestTouchSource   String?
  latestTouchMedium   String?
  latestTouchCampaign String?
  latestTouchAt       DateTime?
  formSubmittedAt     DateTime?
  // WhatsApp marketing consent: UNKNOWN | OPT_IN | OPT_OUT. Never assumed.
  marketingConsent    String    @default("UNKNOWN")
  // Customer choice on the booking page: PAY_ADVANCE | PAY_AFTER_SERVICE (copied to the Job on confirmation).
  paymentPreference String?
  marketingConsentAt  DateTime?

  // Price snapshot frozen at booking (2026-10-05 pricing master): REGULAR |
  // FESTIVAL, the festival name, and the scope text the customer booked.
  // Never recalculated from later price changes.
  priceType    String?
  festivalName String?
  scopeOfWork  String?
  // Multi-service package (Package Calculator): JSON [{group, contentId, name, unit, qty, unitPrice}]
  // and the discount; quoteAmount = subtotal − discount. Carried to the Job on Confirm Booking.
  serviceItems   String?
  discountAmount Float?

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  assignedStaffId String?
  assignedStaff   Staff?  @relation("LeadAssignedStaff", fields: [assignedStaffId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  createdById String?
  createdBy   User?   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations    Quotation[]
  jobs          Job[]
  followUps     FollowUp[]
  payments      Payment[]
  activityLogs  ActivityLog[] @relation("ActivityLead")
  timeline      TimelineEntry[]
  amcContracts  AmcContract[]

  @@index([stage])
  @@index([followUpDate])
  @@index([source])
  @@index([area])
  @@index([createdAt])
  @@index([mobile])
}

model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String          @unique
  // Unguessable token for the customer booking link (/booking?quote=<token>).
  publicToken String?         @unique
  leadId      String
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  services    String // JSON-encoded line items [{name, description, amount}]
  subTotal    Float
  discount    Float           @default(0)
  gstPercent  Float           @default(0)
  gstAmount   Float           @default(0)
  totalAmount Float
  terms       String
  validTill   DateTime?
  pdfUrl      String?
  status      QuotationStatus @default(SENT)
  invoice     Invoice?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([leadId])
  @@index([status])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model FollowUp {
  id           String           @id @default(cuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueDate      DateTime
  type         FollowUpType     @default(CALL)
  priority     FollowUpPriority @default(MEDIUM)
  notes        String?
  isDone       Boolean          @default(false)
  doneAt       DateTime?
  assignedToId String?
  assignedTo   User?            @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime         @default(now())

  @@index([dueDate])
  @@index([isDone])
}

// Conversation timeline — every enquiry keeps a permanent, ordered history of
// notes, voice notes, calls, stage changes, quotations, jobs and payments.
model TimelineEntry {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      TimelineType @default(NOTE)
  body      String?
  audioUrl  String?
  meta      String? // JSON — e.g. { outcome, fromStage, toStage, amount }
  authorId  String?
  author    User?        @relation("TimelineAuthor", fields: [authorId], references: [id])
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────────────────────────────────

model Job {
  id     String @id @default(cuid())
  jobNumber String @unique
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerName    String
  customerMobile  String
  alternateMobile String?
  address         String
  area            String
  pinCode         String?
  service         ServiceType
  serviceVariant  String? // "flat type" / package, carried from the Lead
  propertyType    String? // carried from the Lead
  packageName     String? // optional package tier, carried from the Lead
  comboServices   String? // JSON array of combo bundles, carried from the Lead

  scheduledDate DateTime
  scheduledTime String // time slot, e.g. "10:00 AM"

  teamNumber Int? // internal crew team 1–4, inherited from the Lead / set on the job

  // Customer-facing booking page (/booking/<publicToken>) — unguessable, unlike
  // jobNumber. paymentPreference: PAY_AFTER_SERVICE when the customer chooses it;
  // advanceRequestedAt: when an advance was requested. Paid amounts always come
  // from Payment rows recorded by staff — never marked paid automatically.
  publicToken        String?   @unique
  paymentPreference  String?
  advanceRequestedAt DateTime?

  supervisorId String?
  supervisor   Staff?  @relation("JobSupervisor", fields: [supervisorId], references: [id])

  status      JobStatus @default(ASSIGNED)
  onTheWayAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  jobValue Float
  notes    String?

  customerSignatureUrl String?
  signedAt             DateTime?

  // Frozen crew at completion — JSON [{staffId, name, employeeCode, isLead}].
  // The Staff Portal calendar reads this first, so a completed job always
  // shows the team exactly as it was on that day, even if the crew is
  // edited, a staff record is renamed or soft-deleted later.
  teamSnapshot String?
  serviceItems   String? // package lines carried from the enquiry (Package Calculator)
  discountAmount Float?

  // Price snapshot frozen at booking (2026-10-05 pricing master): REGULAR |
  // FESTIVAL, the festival name, and the scope text the customer booked.
  // Never recalculated from later price changes.
  priceType    String?
  festivalName String?
  scopeOfWork  String?

  mapLink   String?
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments    JobAssignment[]
  photos         Photo[]
  certificate    Certificate?
  payments       Payment[]
  expenses       Expense[]       @relation("ExpenseJob")
  activityLogs   ActivityLog[]   @relation("ActivityJob")
  materialIssues MaterialIssue[]
  invoice        Invoice?
  videos         JobVideo[]

  @@index([status])
  @@index([scheduledDate])
  @@index([area])
  @@index([customerMobile])
}

model JobAssignment {
  id      String  @id @default(cuid())
  jobId   String
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  isLead  Boolean @default(false)

  @@unique([jobId, staffId])
  @@index([staffId])
}

model Photo {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type         PhotoType
  url          String
  caption      String?
  uploadedById String?
  uploadedBy   User?    @relation("PhotoUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([jobId, type])
}

model Certificate {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  certificateNumber String   @unique
  issuedDate        DateTime @default(now())
  customerName      String
  serviceSummary    String
  supervisorName    String?
  signatureUrl      String?
  pdfUrl            String?
  createdAt         DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Payments / expenses
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])

  clientName   String
  clientMobile String?
  amount       Float
  paidAmount   Float          @default(0)
  dueDate      DateTime
  paidDate     DateTime?
  status       PaymentStatus  @default(PENDING)

  mode                  String? // UPI | QR | BANK | CASH — how the advance / collection was made
  mybillbookInvoiceNo   String? // free-text external/reference invoice number, no API tie
  invoiceAttachmentUrl  String? // uploaded invoice PDF or image
  lastReminderAt        DateTime?
  lastReminderChannel   ReminderChannel?

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  invoice Invoice?

  @@index([status])
  @@index([dueDate])
  @@index([paidDate])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Float
  date        DateTime        @default(now())
  paidTo      String?

  jobId String?
  job   Job?    @relation("ExpenseJob", fields: [jobId], references: [id])

  staffId String?
  staff   Staff?  @relation("ExpenseStaff", fields: [staffId], references: [id])

  addedById String?
  addedBy   User?   @relation("ExpenseAddedBy", fields: [addedById], references: [id])

  createdAt DateTime @default(now())

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  @@index([category])
  @@index([date])
  @@index([staffId, category])
}

// ─────────────────────────────────────────────────────────────────────────
// Activity timeline (lead / job audit trail)
// ─────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation("ActivityLead", fields: [leadId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation("ActivityJob", fields: [jobId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id])
  action    String
  meta      String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────
// Company settings — a single row ("default"), editable from /settings
// ─────────────────────────────────────────────────────────────────────────

model CompanySettings {
  id                String  @id @default("default")
  name              String  @default("Sahara Cleaning Services")
  phone             String  @default("7083347130")
  email             String  @default("contact@saharacleaningservices.com")
  address           String  @default("Opp. South Gate, Magarpatta City, Hadapsar, Pune.")
  website           String?
  logoUrl           String?
  googleReviewUrl   String?
  googleRating      String? @default("4.9")
  googleReviewCount String? @default("1800+")
  happyCustomers    String? @default("8000+")
  featuredReviews   String? // JSON [{ name, text, rating }] shown in the booking-page carousel
  bankBalance       Float? // owner-maintained; shown on the Owner Dashboard

  // Payment collection details shown to customers (booking form) and used to
  // build the "Send Payment Link" WhatsApp message.
  upiId              String?
  upiQrUrl           String? // uploaded QR image
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?

  updatedAt DateTime @updatedAt
}

// Company documents library — Profile PDF, PPT, GST, Shop Act, MSME,
// certificates, brochures. Uploaded from /settings and shared to customers
// over WhatsApp / email / direct download.
model CompanyDocument {
  id             String   @id @default(cuid())
  category       String // PROFILE_PDF | PPT | GST | SHOP_ACT | MSME | CERTIFICATE | BROCHURE | OTHER
  label          String
  url            String
  sizeBytes      Int?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([category])
}

