// Sahara OS — Prisma schema
// SQLite for Phase 1. Field types are chosen to be PostgreSQL-compatible
// so migrating `provider = "postgresql"` later needs no schema changes
// beyond enum/array support.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATIONS
  ACCOUNTS
  SUPERVISOR
  STAFF
}

enum LeadSource {
  WHATSAPP
  CALL
  WEBSITE
  GOOGLE
}

enum ServiceType {
  HOME_DEEP_CLEANING
  COMMERCIAL_CLEANING
  HOUSEKEEPING
  PEST_CONTROL
  INTERIOR_PAINTING
}

enum LeadStage {
  NEW
  INTERESTED
  SITE_VISIT
  QUOTATION
  NEGOTIATION
  CONFIRMED
  JOB_SCHEDULED
  COMPLETED
}

enum JobStatus {
  ASSIGNED
  ON_THE_WAY
  STARTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  DUE_SOON
  OVERDUE
  PAID
}

enum ExpenseCategory {
  CHEMICALS
  FUEL
  EQUIPMENT
  STAFF_ADVANCE
  MISCELLANEOUS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum PhotoType {
  BEFORE
  AFTER
}

enum StaffAvailability {
  AVAILABLE
  ON_JOB
  ON_LEAVE
  OFF_DUTY
}

enum SalaryType {
  DAILY
  MONTHLY
}

enum FollowUpType {
  CALL
  WHATSAPP
  SITE_VISIT
  PAYMENT
  CUSTOM
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  CALL
}

// Conversation timeline entry kinds (WhatsApp-style enquiry history).
enum TimelineType {
  NOTE
  VOICE
  CALL
  STAGE
  QUOTATION
  JOB
  PAYMENT
  FOLLOW_UP
  SYSTEM
}

// Phase 2 — Production Foundation
enum ServiceCategory {
  HOME_DEEP_CLEANING
  INDIVIDUAL_CLEANING
  PAINTING
  PEST_CONTROL
  COMMERCIAL_CLEANING
}

// Phase 3 — Revenue, WhatsApp & Workforce Automation
enum AmcCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum AmcFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum AmcStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WhatsAppKind {
  BOOKING_CONFIRMATION
  TEAM_DISPATCH
  CUSTOMER_REMINDER
  PAYMENT_REMINDER
  REVIEW_REQUEST
  AMC_RENEWAL
  ATTENDANCE_SUMMARY
  DEVICE_APPROVAL
  OTHER
}

enum WhatsAppStatus {
  QUEUED
  SENT
  FAILED
}

enum DeviceStatus {
  PENDING
  APPROVED
  DENIED
}

// ─────────────────────────────────────────────────────────────────────────
// Core auth / people
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile      Staff?
  leadsCreated      Lead[]        @relation("LeadCreatedBy")
  leadsAssigned     Lead[]        @relation("LeadAssignedTo")
  followUpsAssigned FollowUp[]    @relation("FollowUpAssignedTo")
  expensesAdded     Expense[]     @relation("ExpenseAddedBy")
  photosUploaded    Photo[]       @relation("PhotoUploadedBy")
  activityLogs      ActivityLog[] @relation("ActivityActor")
  paymentsRecorded  Payment[]     @relation("PaymentRecordedBy")
  timelineEntries   TimelineEntry[] @relation("TimelineAuthor")
  devices           Device[]

  @@index([role])
}

// Owner-controlled device login. Any new (unrecognized) browser/device
// signing in as OPERATIONS or SUPERVISOR needs Altaf's explicit approval
// before a session is issued — see src/server/actions/device-approval.ts
// and src/app/(app)/admin/device-approvals.
model Device {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String       @unique
  label          String?
  ipAddress      String?
  status         DeviceStatus @default(PENDING)
  otpCode        String?
  otpExpiresAt   DateTime?
  approvedAt     DateTime?
  approvedByName String?
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([status])
}

model Staff {
  id                String            @id @default(cuid())
  employeeCode      String            @unique
  name              String
  mobile            String
  designation       String // e.g. Cleaning Executive, Supervisor, Painter, Pest Control Technician
  salaryType         SalaryType        @default(DAILY)
  dailyWage         Float?
  monthlySalary     Float?
  availability      StaffAvailability @default(AVAILABLE)
  joinDate          DateTime          @default(now())
  isActive          Boolean           @default(true)
  photoUrl          String?
  notes             String?
  qrCode            String?           @unique // future QR check-in token
  userId            String?           @unique
  user              User?             @relation(fields: [userId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  isDemo            Boolean           @default(false)
  deletedAt         DateTime?
  deletedByName     String?

  attendance        Attendance[]
  jobAssignments    JobAssignment[]
  supervisedJobs    Job[]             @relation("JobSupervisor")
  leadAssignments   Lead[]            @relation("LeadAssignedStaff")
  expenses          Expense[]         @relation("ExpenseStaff")
  advances          Advance[]
  fines             FineRecord[]
  rewards           RewardRecord[]

  @@index([availability])
  @@index([designation])
}

model Attendance {
  id           String            @id @default(cuid())
  staffId      String
  staff        Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date         DateTime
  status       AttendanceStatus  @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?
  wageForDay   Float?
  gpsLat       Float? // future GPS attendance
  gpsLng       Float? // future GPS attendance
  method       String            @default("MANUAL") // MANUAL | QR | GPS (future-ready)
  notes        String?
  createdAt    DateTime          @default(now())

  @@unique([staffId, date])
  @@index([date])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Leads / CRM pipeline
// ─────────────────────────────────────────────────────────────────────────

model Lead {
  id               String      @id @default(cuid())
  leadNumber       String      @unique
  name             String
  mobile           String
  whatsapp         String?
  address          String?
  area             String
  service          ServiceType
  source           LeadSource
  quoteAmount      Float?
  stage            LeadStage   @default(NEW)
  followUpDate     DateTime?
  notes            String?

  serviceCategory  ServiceCategory?
  serviceVariant   String?
  mapLink          String?
  referralCode     String?

  isDemo           Boolean     @default(false)
  deletedAt        DateTime?
  deletedByName    String?

  assignedStaffId  String?
  assignedStaff    Staff?      @relation("LeadAssignedStaff", fields: [assignedStaffId], references: [id])

  assignedToId     String?
  assignedTo       User?       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  createdById      String?
  createdBy        User?       @relation("LeadCreatedBy", fields: [createdById], references: [id])

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  quotations   Quotation[]
  jobs         Job[]
  followUps    FollowUp[]
  payments     Payment[]
  activityLogs ActivityLog[]   @relation("ActivityLead")
  timeline     TimelineEntry[]
  amcContracts AmcContract[]

  @@index([stage])
  @@index([followUpDate])
  @@index([source])
  @@index([area])
  @@index([createdAt])
}

model Quotation {
  id             String    @id @default(cuid())
  quoteNumber    String    @unique
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  services       String // JSON-encoded line items [{name, description, amount}]
  subTotal       Float
  gstPercent     Float     @default(0)
  gstAmount      Float     @default(0)
  totalAmount    Float
  terms          String
  validTill      DateTime?
  pdfUrl         String?
  createdAt      DateTime  @default(now())

  @@index([leadId])
}

model FollowUp {
  id           String          @id @default(cuid())
  leadId       String
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueDate      DateTime
  type         FollowUpType    @default(CALL)
  priority     FollowUpPriority @default(MEDIUM)
  notes        String?
  isDone       Boolean         @default(false)
  doneAt       DateTime?
  assignedToId String?
  assignedTo   User?           @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime        @default(now())

  @@index([dueDate])
  @@index([isDone])
}

// Conversation timeline — every enquiry keeps a permanent, ordered history of
// notes, voice notes, calls, stage changes, quotations, jobs and payments.
model TimelineEntry {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      TimelineType @default(NOTE)
  body      String?
  audioUrl  String?
  meta      String? // JSON — e.g. { outcome, fromStage, toStage, amount }
  authorId  String?
  author    User?        @relation("TimelineAuthor", fields: [authorId], references: [id])
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────────────────────────────────

model Job {
  id               String    @id @default(cuid())
  jobNumber        String    @unique
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id])

  customerName     String
  customerMobile   String
  address          String
  area             String
  service          ServiceType

  scheduledDate    DateTime
  scheduledTime    String // e.g. "10:00 AM"

  supervisorId     String?
  supervisor       Staff?    @relation("JobSupervisor", fields: [supervisorId], references: [id])

  status           JobStatus @default(ASSIGNED)
  onTheWayAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?

  jobValue         Float
  notes            String?

  customerSignatureUrl String?
  signedAt             DateTime?

  mapLink       String?
  vehicleId     String?
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id])

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignments    JobAssignment[]
  photos         Photo[]
  certificate    Certificate?
  payments       Payment[]
  expenses       Expense[]       @relation("ExpenseJob")
  activityLogs   ActivityLog[]   @relation("ActivityJob")
  materialIssues MaterialIssue[]
  invoice        Invoice?
  videos         JobVideo[]

  @@index([status])
  @@index([scheduledDate])
  @@index([area])
}

model JobAssignment {
  id      String @id @default(cuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  isLead  Boolean @default(false)

  @@unique([jobId, staffId])
  @@index([staffId])
}

model Photo {
  id           String    @id @default(cuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type         PhotoType
  url          String
  caption      String?
  uploadedById String?
  uploadedBy   User?     @relation("PhotoUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())

  @@index([jobId, type])
}

model Certificate {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  certificateNumber String   @unique
  issuedDate        DateTime @default(now())
  customerName      String
  serviceSummary    String
  supervisorName    String?
  signatureUrl      String?
  pdfUrl            String?
  createdAt         DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Payments / expenses
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  jobId             String?
  job               Job?          @relation(fields: [jobId], references: [id])
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id])

  clientName        String
  clientMobile      String?
  amount            Float
  paidAmount        Float         @default(0)
  dueDate           DateTime
  paidDate          DateTime?
  status            PaymentStatus @default(PENDING)

  mybillbookInvoiceNo String?
  lastReminderAt       DateTime?
  lastReminderChannel  ReminderChannel?

  recordedById      String?
  recordedBy        User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  isDemo            Boolean       @default(false)
  deletedAt         DateTime?
  deletedByName     String?

  invoice           Invoice?

  @@index([status])
  @@index([dueDate])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Float
  date        DateTime        @default(now())
  paidTo      String?

  jobId       String?
  job         Job?            @relation("ExpenseJob", fields: [jobId], references: [id])

  staffId     String?
  staff       Staff?          @relation("ExpenseStaff", fields: [staffId], references: [id])

  addedById   String?
  addedBy     User?           @relation("ExpenseAddedBy", fields: [addedById], references: [id])

  createdAt   DateTime        @default(now())

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  @@index([category])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────
// Activity timeline (lead / job audit trail)
// ─────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation("ActivityLead", fields: [leadId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation("ActivityJob", fields: [jobId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id])
  action    String
  meta      String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────
// Company settings — a single row ("default"), editable from /settings
// ─────────────────────────────────────────────────────────────────────────

model CompanySettings {
  id        String   @id @default("default")
  name      String   @default("Sahara Cleaning Services")
  phone     String   @default("7083347130")
  email     String   @default("contact@saharacleaningservices.com")
  address   String   @default("Opp. South Gate, Magarpatta City, Hadapsar, Pune.")
  logoUrl   String?
  googleReviewUrl String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — Production Foundation: audit trail, soft-delete support,
// vehicles, material issue, customer reviews, backup log.
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // "Lead" | "Job" | "Staff" | "Payment" | "Expense" | "Backup"
  entityId   String
  action     String // "DELETE" | "RESTORE" | "BULK_DELETE" | "BULK_RESTORE" | "BACKUP" | "RESTORE_BACKUP"
  summary    String
  actorName  String?
  actorEmail String?
  meta       String? // JSON
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Vehicle {
  id          String   @id @default(cuid())
  name        String
  plateNumber String   @unique
  type        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  jobs Job[]
}

model MaterialIssue {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item         String
  quantity     String?
  issuedByName String?
  issuedAt     DateTime @default(now())

  @@index([jobId])
}

model Review {
  id             String   @id @default(cuid())
  customerMobile String
  customerName   String?
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  @@index([customerMobile])
}

model BackupEvent {
  id          String   @id @default(cuid())
  kind        String // "AUTO" | "MANUAL" | "RESTORE"
  triggeredBy String?
  fileName    String?
  sizeBytes   Int?
  status      String   @default("SUCCESS")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Revenue, WhatsApp & Workforce Automation
// ─────────────────────────────────────────────────────────────────────────

// Outbound WhatsApp send log. Every automated message (booking confirmation,
// team dispatch, reminders, review requests, AMC renewals, attendance
// summaries) is written here first. If WHATSAPP_ACCESS_TOKEN /
// WHATSAPP_PHONE_NUMBER_ID aren't configured yet, the row is left QUEUED
// instead of sent — nothing is lost, and the send resumes automatically the
// moment credentials are added. See src/lib/whatsapp.ts.
model WhatsAppMessage {
  id                String         @id @default(cuid())
  kind              WhatsAppKind
  toNumber          String
  toName            String?
  body              String
  status            WhatsAppStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  relatedType       String?
  relatedId         String?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

model AmcContract {
  id              String           @id @default(cuid())
  contractNumber  String           @unique
  customerName    String
  customerMobile  String
  address         String?
  area            String?
  category        AmcCategory
  frequency       AmcFrequency
  serviceCategory ServiceCategory?
  amount          Float
  startDate       DateTime
  nextVisitDate   DateTime
  lastVisitDate   DateTime?
  status          AmcStatus        @default(ACTIVE)
  notes           String?
  leadId          String?
  lead            Lead?            @relation(fields: [leadId], references: [id])

  isDemo        Boolean   @default(false)
  deletedAt     DateTime?
  deletedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits AmcVisit[]

  @@index([status])
  @@index([nextVisitDate])
}

model AmcVisit {
  id        String      @id @default(cuid())
  amcId     String
  amc       AmcContract @relation(fields: [amcId], references: [id], onDelete: Cascade)
  visitDate DateTime
  jobId     String?
  notes     String?
  createdAt DateTime    @default(now())

  @@index([amcId])
}

// Combo/upsell rules shown during booking (e.g. Deep Cleaning + Sofa) and the
// events used to track how often they're shown vs. actually accepted.
model UpsellRule {
  id              String          @id @default(cuid())
  label           String
  triggerCategory ServiceCategory
  comboCategory   ServiceCategory
  comboVariant    String?
  comboPrice      Float?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
}

model UpsellEvent {
  id         String    @id @default(cuid())
  ruleId     String?
  leadId     String?
  label      String
  comboValue Float?
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([leadId])
  @@index([accepted])
}

model Advance {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String?
  givenAt     DateTime @default(now())
  givenByName String?
  createdAt   DateTime @default(now())

  @@index([staffId])
}

model FineRecord {
  id             String   @id @default(cuid())
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type           String
  amount         Float    @default(0)
  notes          String?
  date           DateTime @default(now())
  recordedByName String?
  createdAt      DateTime @default(now())

  @@index([staffId])
}

model RewardRecord {
  id             String   @id @default(cuid())
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type           String
  amount         Float    @default(0)
  notes          String?
  date           DateTime @default(now())
  recordedByName String?
  createdAt      DateTime @default(now())

  @@index([staffId])
}

// CRM-native quotation/invoice document. mybillbookSyncStatus reflects the
// MyBillBook push: NOT_CONFIGURED until an API key is supplied (see
// src/lib/mybillbook.ts), then QUEUED/SYNCED/FAILED.
model Invoice {
  id                   String   @id @default(cuid())
  invoiceNumber        String   @unique
  jobId                String?  @unique
  job                  Job?     @relation(fields: [jobId], references: [id])
  paymentId            String?  @unique
  payment              Payment? @relation(fields: [paymentId], references: [id])
  customerName         String
  customerMobile       String?
  customerAddress      String?
  lineItems            String // JSON [{name, description, amount}]
  subTotal             Float
  gstPercent           Float    @default(0)
  gstAmount            Float    @default(0)
  totalAmount          Float
  pdfUrl               String?
  mybillbookInvoiceId  String?
  mybillbookSyncStatus String   @default("NOT_CONFIGURED")
  createdAt            DateTime @default(now())

  @@index([jobId])
}

model JobVideo {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  uploadedAt DateTime @default(now())

  @@index([jobId])
}
