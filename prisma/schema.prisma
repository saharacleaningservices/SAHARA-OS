}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Revenue, WhatsApp & Workforce Automation
// ─────────────────────────────────────────────────────────────────────────

// Outbound WhatsApp send log. Every automated message (booking confirmation,
// team dispatch, reminders, review requests, AMC renewals, attendance
// summaries) is written here first. If WHATSAPP_ACCESS_TOKEN /
// WHATSAPP_PHONE_NUMBER_ID aren't configured yet, the row is left QUEUED
// instead of sent — nothing is lost, and the send resumes automatically the
// moment credentials are added. See src/lib/whatsapp.ts.
// One row per customer WhatsApp number: who is handling the conversation.
// mode AI = the grounded assistant may answer; HUMAN = staff only (takeover).
model WhatsAppConversation {
  id            String   @id @default(cuid())
  number        String   @unique
  mode          String   @default("HUMAN")
  handoffReason String?
  changedByName String?
  changedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsAppMessage {
  id                String         @id @default(cuid())
  kind              WhatsAppKind
  toNumber          String
  toName            String?
  body              String
  status            WhatsAppStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  relatedType       String?
  relatedId         String?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?
  // Cloud API go-live additions: inbound rows, delivery/read receipts,
  // and which approved template (if any) an outbound row used.
  direction         String         @default("OUTBOUND") // OUTBOUND | INBOUND
  deliveredAt       DateTime?
  readAt            DateTime?
  templateName      String?
  // Who sent an outbound message from the CRM (staff user, or the AI assistant).
  sentByUserId      String?
  sentByName        String?

  @@index([kind])
  @@index([status])
  @@index([toNumber])
  @@index([providerMessageId])
  @@index([createdAt])
}

// Per-number WhatsApp consent/opt-out state (Meta Cloud API policy requires
// honoring STOP/UNSUBSCRIBE-style replies). sendWhatsApp() checks this
// before every send and skips (logging why) rather than messaging an opted-
// out number; the inbound webhook flips it automatically when a customer
// texts an opt-out/opt-in keyword, and it can also be set by hand from the
// Message Log. phoneNumber uses the same normalized format as
// WhatsAppMessage.toNumber. See src/lib/whatsapp.ts.
model WhatsAppConsent {
  id           String    @id @default(cuid())
  phoneNumber  String    @unique
  optedOut     Boolean   @default(false)
  optedOutAt   DateTime?
  optedOutVia  String? // "CUSTOMER_REPLY" | "MANUAL"
  reinstatedAt DateTime?
  notes        String?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([optedOut])
}

model AmcContract {
  id                  String       @id @default(cuid())
