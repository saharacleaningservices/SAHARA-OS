DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Sahara OS"

# Optional (future): enable the LLM-backed AI Assistant instead of the
# built-in rule-based engine. Leave unset to keep everything local/offline.
# ANTHROPIC_API_KEY=

# Optional — booking.*/crm.* domain split (2026-09-22). Leave both unset to
# keep everything on the single existing app.saharacleaningservices.com
# domain, exactly as today. Set both together, only after DNS + Coolify are
# confirmed working for each new subdomain — see the URL-migration section
# of the developer handover docs.
# BOOKING_URL="https://booking.saharacleaningservices.com"
# CRM_URL="https://crm.saharacleaningservices.com"
# Set to "true" only once booking.*/crm.* are both verified in production —
# turns on the old app.* → crm.* redirect (booking/job/gallery/legal paths on
# the old domain are never redirected, so previously-shared links keep working).
# LEGACY_APP_REDIRECT_ENABLED="true"

# Optional — copy each new website lead to a Google Sheet (after it is saved in
# the CRM). Off unless BOTH are set. Script + setup: scripts/google-sheets-lead-webhook.gs
# LEADS_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/<deployment-id>/exec"
# LEADS_SHEET_WEBHOOK_SECRET=

# Ops reminders (job closure / payment collection / escalation / daily summary).
# Runs in-process every 60 s in production; "off" disables it, "on" also runs it under npm run dev.
# Settings (intervals, quiet hours, escalation, sound) are edited in the CRM: /admin/reminders.
# OPS_REMINDERS_SCHEDULER=off

# Cognito / e-mail lead intake (POST /api/webhook/email-lead) — owner sets values in Coolify.
# Bearer token the Apps Script sends (Script property LEAD_TOKEN = same value). Falls back to CRON_TOKEN.
EMAIL_LEAD_TOKEN=
# Optional HMAC-SHA256 request signing. When set, unsigned requests are rejected (401).
# Set the SAME value as Script property HMAC_SECRET in the Apps Script at the same time.
EMAIL_LEAD_HMAC_SECRET=

# Meta Conversions API (server-side Lead events). Owner enters the value in Coolify - never commit it.
META_CAPI_TOKEN=
# Optional: Test Event Code from Events Manager (testing only; remove after).
META_CAPI_TEST_CODE=

# Ad tracking (build-time NEXT_PUBLIC_* — set in Coolify, then redeploy). Names only; nothing here is a secret.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=<conversion label for the lead form>
# NEXT_PUBLIC_META_PIXEL_ID=<pixel/dataset id>   (server side: META_CAPI_TOKEN, runtime only)
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=<LinkedIn Insight Tag partner id, digits>
# NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=<optional LinkedIn conversion rule id for a lead>
